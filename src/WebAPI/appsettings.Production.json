{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};MultipleActiveResultSets=true;TrustServerCertificate=False;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "${APPINSIGHTS_CONNECTION_STRING}",
    "EnableAdaptiveSampling": true,
    "EnablePerformanceCounterCollectionModule": true,
    "EnableQuickPulseMetricStream": true,
    "EnableHeartbeat": true,
    "EnableAzureInstanceMetadataTelemetryModule": true,
    "EnableDependencyTracking": true,
    "EnableRequestTracking": true,
    "EnableExceptionTracking": true
  },
  "TranslationCacheWarmup": {
    "EnableBackgroundWarmup": true,
    "WarmupIntervalHours": 6,
    "MaxFeaturesPerCulture": 20,
    "DelayBetweenRequestsMs": 50
  },
  "TranslationValidation": {
    "ValidationIntervalHours": 24,
    "MissingKeysThreshold": 50,
    "MinimumCompletionPercentage": 95.0,
    "AutoUpdateCompleteness": true,
    "Enabled": true
  },
  "CacheSettings": {
    "Enabled": true,
    "UseRedis": true,
    "RedisConnectionString": "${REDIS_CONNECTION_STRING}",
    "DefaultExpirationMinutes": 120,
    "EnableResponseCaching": true,
    "EnableOutputCaching": true,
    "EnableMemoryCache": true,
    "EnableDistributedCache": true,
    "EnableTagBasedInvalidation": true,
    "TagExpirationMinutes": 1440,
    "MaxMemoryCacheSize": 500,
    "CompactionPercentage": 20,
    "ScanFrequencySeconds": 120,
    "RedisDatabase": 0,
    "RedisKeyPrefix": "CommunityCarApp:Prod:",
    "RedisConnectTimeout": 10000,
    "RedisCommandTimeout": 10000,
    "ResponseCacheMaxAge": 600,
    "ResponseCacheVaryByQueryKeys": true,
    "ResponseCacheVaryByHeaders": ["Accept-Language", "Authorization"],
    "OutputCacheDefaultExpiration": 300,
    "OutputCacheVaryByUser": true,
    "OutputCacheVaryByRole": true
  },
  "TranslationCdn": {
    "Enabled": true,
    "Provider": "CloudFlare",
    "BaseUrl": "${CDN_BASE_URL}",
    "TranslationPath": "/translations",
    "CacheExpiryHours": 24,
    "EnableCacheBusting": true,
    "EnableCompression": true,
    "EnableMinification": true,
    "EnableVersioning": true,
    "PurgeOnUpdate": true,
    "CloudFlare": {
      "ApiKey": "${CLOUDFLARE_API_KEY}",
      "ZoneId": "${CLOUDFLARE_ZONE_ID}",
      "Email": "${CLOUDFLARE_EMAIL}",
      "EnableAutoPurge": true,
      "PurgeDelay": 300
    },
    "Azure": {
      "StorageConnectionString": "${AZURE_STORAGE_CONNECTION_STRING}",
      "ContainerName": "translations",
      "CdnEndpoint": "${AZURE_CDN_ENDPOINT}",
      "CdnProfileName": "${AZURE_CDN_PROFILE}",
      "ResourceGroup": "${AZURE_RESOURCE_GROUP}",
      "EnableCdnPurge": true
    },
    "AWS": {
      "AccessKey": "${AWS_ACCESS_KEY}",
      "SecretKey": "${AWS_SECRET_KEY}",
      "Region": "${AWS_REGION}",
      "BucketName": "${AWS_S3_BUCKET}",
      "CloudFrontDistributionId": "${AWS_CLOUDFRONT_DISTRIBUTION_ID}",
      "EnableCloudFrontInvalidation": true
    }
  },
  "TranslationMonitoring": {
    "Enabled": true,
    "EnablePerformanceTracking": true,
    "EnableErrorTracking": true,
    "EnableUsageAnalytics": true,
    "EnableCacheMetrics": true,
    "EnableCdnMetrics": true,
    "SlowTranslationThresholdMs": 100,
    "CacheMissThresholdPercent": 20.0,
    "ErrorRateThresholdPercent": 1.0,
    "AlertingEnabled": true,
    "AlertRecipients": ["${ALERT_EMAIL}"],
    "AlertOnSlowTranslations": true,
    "AlertOnHighCacheMiss": true,
    "AlertOnHighErrorRate": true,
    "AlertOnMissingTranslations": true,
    "MetricsRetentionDays": 90,
    "EnableDashboard": true
  },
  "HealthChecks": {
    "EnableHealthChecks": true,
    "HealthCheckEndpoint": "/health",
    "DetailedHealthCheckEndpoint": "/health/detailed",
    "CheckDatabase": true,
    "CheckRedis": true,
    "CheckExternalServices": true,
    "CheckTranslationCdn": true,
    "CheckTranslationCache": true,
    "HealthCheckTimeout": 30,
    "EnableLivenessProbe": true,
    "EnableReadinessProbe": true,
    "LivenessEndpoint": "/health/live",
    "ReadinessEndpoint": "/health/ready"
  },
  "Security": {
    "EnableInputSanitization": true,
    "EnableXssProtection": true,
    "EnableSqlInjectionProtection": true,
    "EnableCsrfProtection": true,
    "RequireHttps": true,
    "EnableHsts": true,
    "HstsMaxAge": 31536000,
    "EnableContentSecurityPolicy": true,
    "TrustedDomains": ["${PRODUCTION_DOMAIN}"],
    "OtpExpiryMinutes": 5,
    "LockoutThreshold": 5,
    "LockoutDurationMinutes": 15,
    "RateLimitRequestsPerMinute": 100
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "DefaultRules": {
      "PerMinute": 100,
      "PerHour": 5000,
      "PerDay": 50000
    },
    "EndpointRules": {
      "POST:/api/v1/auth/login": {
        "PerMinute": 10,
        "PerHour": 50
      },
      "POST:/api/v1/auth/register": {
        "PerMinute": 5,
        "PerHour": 20
      },
      "GET:/api/v7/localization/translations/*": {
        "PerMinute": 200,
        "PerHour": 10000
      },
      "POST:/api/v7/localization/translations/batch": {
        "PerMinute": 100,
        "PerHour": 5000
      }
    }
  }
}
