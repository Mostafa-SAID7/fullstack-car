{
  "name": "Microsoft Fluent",
  "description": "Modern Microsoft Fluent Design System with clean lines and subtle shadows",
  "version": "1.0.0",
  "category": "Corporate",
  "variables": {
    "primary-color": "#0078d4",
    "secondary-color": "#106ebe",
    "accent-color": "#005a9e",
    "success-color": "#107c10",
    "warning-color": "#ff8c00",
    "error-color": "#d13438",
    "info-color": "#0078d4",
    "background-primary": "#ffffff",
    "background-secondary": "#faf9f8",
    "background-tertiary": "#f3f2f1",
    "surface-primary": "#ffffff",
    "surface-secondary": "#f3f2f1",
    "text-primary": "#323130",
    "text-secondary": "#605e5c",
    "text-tertiary": "#8a8886",
    "text-disabled": "#a19f9d",
    "border-primary": "#edebe9",
    "border-secondary": "#d2d0ce",
    "border-focus": "#0078d4",
    "shadow-small": "0 1px 2px rgba(0,0,0,0.1)",
    "shadow-medium": "0 2px 4px rgba(0,0,0,0.14)",
    "shadow-large": "0 4px 8px rgba(0,0,0,0.18)",
    "border-radius-small": "2px",
    "border-radius-medium": "4px",
    "border-radius-large": "8px",
    "font-family-primary": "Segoe UI, system-ui, sans-serif",
    "font-family-monospace": "Consolas, Monaco, monospace",
    "font-size-xs": "11px",
    "font-size-sm": "12px",
    "font-size-base": "14px",
    "font-size-lg": "16px",
    "font-size-xl": "18px",
    "font-size-2xl": "20px",
    "font-size-3xl": "24px",
    "font-weight-light": "300",
    "font-weight-normal": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-weight-bold": "700",
    "spacing-xs": "4px",
    "spacing-sm": "8px",
    "spacing-md": "12px",
    "spacing-lg": "16px",
    "spacing-xl": "20px",
    "spacing-2xl": "24px",
    "spacing-3xl": "32px",
    "transition-fast": "0.1s ease",
    "transition-normal": "0.2s ease",
    "transition-slow": "0.3s ease"
  },
  "components": {
    "button": {
      "primary": {
        "background": "var(--primary-color)",
        "color": "#ffffff",
        "border": "1px solid var(--primary-color)",
        "border-radius": "var(--border-radius-medium)",
        "padding": "8px 16px",
        "font-weight": "var(--font-weight-semibold)",
        "transition": "var(--transition-normal)"
      },
      "secondary": {
        "background": "transparent",
        "color": "var(--primary-color)",
        "border": "1px solid var(--primary-color)",
        "border-radius": "var(--border-radius-medium)",
        "padding": "8px 16px",
        "font-weight": "var(--font-weight-semibold)",
        "transition": "var(--transition-normal)"
      }
    },
    "card": {
      "background": "var(--surface-primary)",
      "border": "1px solid var(--border-primary)",
      "border-radius": "var(--border-radius-medium)",
      "box-shadow": "var(--shadow-small)",
      "padding": "var(--spacing-lg)"
    },
    "input": {
      "background": "var(--surface-primary)",
      "border": "1px solid var(--border-secondary)",
      "border-radius": "var(--border-radius-medium)",
      "padding": "8px 12px",
      "font-size": "var(--font-size-base)",
      "transition": "var(--transition-normal)"
    }
  }
}