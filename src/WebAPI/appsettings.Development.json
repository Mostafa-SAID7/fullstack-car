{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "TranslationCacheWarmup": {
    "EnableBackgroundWarmup": false,
    "WarmupIntervalHours": 6,
    "MaxFeaturesPerCulture": 20,
    "DelayBetweenRequestsMs": 100
  },
  "CacheSettings": {
    "Enabled": true,
    "UseRedis": false,
    "EnableMemoryCache": true,
    "EnableDistributedCache": false,
    "MaxMemoryCacheSize": 50,
    "CompactionPercentage": 25,
    "ScanFrequencySeconds": 60
  }
}