# Test Environment Configuration for Dashboard
# Copy this file to .env.test and fill in the values

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Authentication
TEST_AUTH_TOKEN=your_test_jwt_token_here
TEST_ADMIN_USERNAME=admin@test.com
TEST_ADMIN_PASSWORD=TestPassword123!

# Test Service Provider ID (for service creation tests)
TEST_SERVICE_PROVIDER_ID=00000000-0000-0000-0000-000000000000

# SignalR Hub URL
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/marketplace

# Test Configuration
TEST_TIMEOUT=10000
TEST_RETRY_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_INTEGRATION_TESTS=true
VITE_SKIP_AUTH_IN_TESTS=false

# Logging
VITE_LOG_LEVEL=debug
VITE_LOG_API_REQUESTS=true
