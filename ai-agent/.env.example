# AI Agent Configuration
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Get from https://huggingface.co/settings/tokens
MODEL_NAME=microsoft/DialoGPT-medium
CACHE_DIR=./models_cache

# Database Configuration
# Choose one of the following options:

# Option 1: SQL Server with Windows Authentication (Recommended for Windows)
DATABASE_URL=mssql+pyodbc://localhost/CCarDb?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Option 2: SQL Server with SQL Authentication
# DATABASE_URL=mssql+pyodbc://username:password@localhost/CCarDb?driver=ODBC+Driver+17+for+SQL+Server

# Option 3: SQL Server with custom instance
# DATABASE_URL=mssql+pyodbc://localhost\\SQLEXPRESS/CCarDb?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Option 4: SQLite (for development/testing)
# DATABASE_URL=sqlite:///./community_car_ai.db

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Model Configuration
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=automotive_knowledge

# OpenAI (optional, for fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Backend Integration
BACKEND_API_URL=http://localhost:5000
BACKEND_API_KEY=your_backend_api_key

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ai_agent.log

# Rate Limiting
RATE_LIMIT_USER=100  # Requests per user per hour
RATE_LIMIT_IP=200  # Requests per IP per hour
RATE_LIMIT_WINDOW=3600  # Time window in seconds (1 hour)
RATE_LIMIT_ADMIN_BYPASS=True  # Allow admins to bypass limits
