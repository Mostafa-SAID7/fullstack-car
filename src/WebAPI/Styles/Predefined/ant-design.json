{
  "name": "Ant Design",
  "description": "Enterprise-class UI design language with refined details",
  "version": "1.0.0",
  "category": "Enterprise",
  "variables": {
    "primary-color": "#1890ff",
    "secondary-color": "#722ed1",
    "accent-color": "#fa541c",
    "success-color": "#52c41a",
    "warning-color": "#faad14",
    "error-color": "#f5222d",
    "info-color": "#1890ff",
    "background-primary": "#ffffff",
    "background-secondary": "#fafafa",
    "background-tertiary": "#f0f0f0",
    "surface-primary": "#ffffff",
    "surface-secondary": "#fafafa",
    "text-primary": "#000000d9",
    "text-secondary": "#00000073",
    "text-tertiary": "#00000040",
    "text-disabled": "#00000025",
    "border-primary": "#d9d9d9",
    "border-secondary": "#f0f0f0",
    "border-focus": "#1890ff",
    "shadow-small": "0 2px 8px rgba(0,0,0,0.15)",
    "shadow-medium": "0 4px 12px rgba(0,0,0,0.15)",
    "shadow-large": "0 9px 28px rgba(0,0,0,0.15)",
    "border-radius-small": "2px",
    "border-radius-medium": "6px",
    "border-radius-large": "8px",
    "font-family-primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-family-monospace": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace",
    "font-size-xs": "12px",
    "font-size-sm": "12px",
    "font-size-base": "14px",
    "font-size-lg": "16px",
    "font-size-xl": "20px",
    "font-size-2xl": "24px",
    "font-size-3xl": "30px",
    "font-weight-light": "300",
    "font-weight-normal": "400",
    "font-weight-medium": "500",
    "font-weight-semibold": "600",
    "font-weight-bold": "700",
    "spacing-xs": "4px",
    "spacing-sm": "8px",
    "spacing-md": "12px",
    "spacing-lg": "16px",
    "spacing-xl": "24px",
    "spacing-2xl": "32px",
    "spacing-3xl": "48px",
    "transition-fast": "0.1s ease",
    "transition-normal": "0.3s ease",
    "transition-slow": "0.5s ease"
  },
  "components": {
    "button": {
      "primary": {
        "background": "var(--primary-color)",
        "color": "#ffffff",
        "border": "1px solid var(--primary-color)",
        "border-radius": "var(--border-radius-medium)",
        "padding": "4px 15px",
        "font-size": "var(--font-size-base)",
        "font-weight": "var(--font-weight-normal)",
        "line-height": "1.5715",
        "transition": "var(--transition-normal)"
      },
      "secondary": {
        "background": "#ffffff",
        "color": "var(--text-primary)",
        "border": "1px solid var(--border-primary)",
        "border-radius": "var(--border-radius-medium)",
        "padding": "4px 15px",
        "font-size": "var(--font-size-base)",
        "font-weight": "var(--font-weight-normal)",
        "line-height": "1.5715",
        "transition": "var(--transition-normal)"
      }
    },
    "card": {
      "background": "var(--surface-primary)",
      "border": "1px solid var(--border-secondary)",
      "border-radius": "var(--border-radius-medium)",
      "box-shadow": "var(--shadow-small)",
      "padding": "var(--spacing-xl)"
    },
    "input": {
      "background": "var(--surface-primary)",
      "border": "1px solid var(--border-primary)",
      "border-radius": "var(--border-radius-medium)",
      "padding": "4px 11px",
      "font-size": "var(--font-size-base)",
      "line-height": "1.5715",
      "transition": "var(--transition-normal)"
    }
  }
}