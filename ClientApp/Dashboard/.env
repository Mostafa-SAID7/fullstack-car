# =============================================================================
# COMMUNITY CAR DASHBOARD - ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains all environment variables needed for the dashboard
# Copy this file to .env.local for local development
# For production, set these variables in your deployment platform
# =============================================================================

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Main API Base URL - Update this for production deployment
VITE_API_BASE_URL=http://localhost:5100/api

# AI Agent Service URL
VITE_AI_AGENT_URL=http://localhost:8003/api

# WebSocket URL for real-time features (SignalR)
VITE_WS_URL=ws://localhost:5100/hub

# API Version (used for versioning endpoints)
VITE_API_VERSION=v1

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application Version
VITE_APP_VERSION=1.0.0

# Application Name
VITE_APP_NAME=Community Car Dashboard

# Application Description
VITE_APP_DESCRIPTION=Community Car Management Dashboard

# Application Environment (development, staging, production)
VITE_APP_ENV=development

# Debug Mode (true/false)
VITE_DEBUG=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Core Features
VITE_FEATURE_AI_AGENT=true
VITE_FEATURE_ANALYTICS=true
VITE_FEATURE_REAL_TIME=true
VITE_FEATURE_FILE_UPLOAD=true
VITE_FEATURE_NOTIFICATIONS=true

# Advanced Features
VITE_FEATURE_ADVANCED_ANALYTICS=true
VITE_FEATURE_EXPORT_DATA=true
VITE_FEATURE_BULK_ACTIONS=true
VITE_FEATURE_MULTI_LANGUAGE=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_ADVANCED_SECURITY=true
VITE_FEATURE_AUDIT_LOGGING=true

# Marketplace Features
VITE_FEATURE_MARKETPLACE=true
VITE_FEATURE_MARKETPLACE_ANALYTICS=true
VITE_FEATURE_MARKETPLACE_REPORTS=true

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Token Expiration (in minutes)
VITE_JWT_EXPIRATION=60

# Refresh Token Expiration (in days)
VITE_REFRESH_TOKEN_EXPIRATION=7

# Session Timeout (in minutes)
VITE_SESSION_TIMEOUT=30

# OAuth Providers (true/false)
VITE_OAUTH_GOOGLE=true
VITE_OAUTH_GITHUB=true
VITE_OAUTH_FACEBOOK=false

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================
# Default Theme (light/dark/system)
VITE_DEFAULT_THEME=light

# Default Language (en, es, fr, de, etc.)
VITE_DEFAULT_LANGUAGE=en

# Pagination Settings
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# File Upload Settings
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
# Google Analytics ID (if using Google Analytics)
VITE_GA_TRACKING_ID=

# Application Insights Key (if using Azure Application Insights)
VITE_APP_INSIGHTS_KEY=

# Sentry DSN (if using Sentry for error tracking)
VITE_SENTRY_DSN=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# CDN URL for static assets
VITE_CDN_URL=

# Media Storage URL
VITE_MEDIA_URL=

# Email Service Configuration
VITE_EMAIL_SERVICE_URL=

# SMS Service Configuration
VITE_SMS_SERVICE_URL=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Hot Module Replacement (true/false)
VITE_HMR=true

# Source Maps (true/false)
VITE_SOURCE_MAPS=true

# Mock Data (true/false) - Use mock data instead of real API calls
VITE_USE_MOCK_DATA=false

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=10000

# =============================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =============================================================================
# Build Output Directory
VITE_BUILD_DIR=dist

# Public Path (for CDN deployment)
VITE_PUBLIC_PATH=/

# Asset Optimization
VITE_MINIFY=true
VITE_COMPRESS=true

# =============================================================================
# SOCIAL MEDIA & BRANDING
# =============================================================================
# Company/Organization Name
VITE_COMPANY_NAME=Community Car

# Company Website
VITE_COMPANY_WEBSITE=https://communitycar.com

# Support Email
VITE_SUPPORT_EMAIL=support@communitycar.com

# Social Media Links
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=

# =============================================================================
# MARKETPLACE CONFIGURATION
# =============================================================================
# Marketplace Features
VITE_MARKETPLACE_COMMISSION_RATE=0.05
VITE_MARKETPLACE_CURRENCY=USD
VITE_MARKETPLACE_TAX_RATE=0.08

# Payment Processing
VITE_PAYMENT_PROVIDER=stripe
VITE_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# LOCALIZATION
# =============================================================================
# Supported Languages (comma-separated)
VITE_SUPPORTED_LANGUAGES=en,es,fr,de

# Default Timezone
VITE_DEFAULT_TIMEZONE=UTC

# Date Format
VITE_DATE_FORMAT=MM/DD/YYYY

# Currency Format
VITE_CURRENCY_FORMAT=USD

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================
# Cache Duration (in seconds)
VITE_CACHE_DURATION=3600

# Service Worker (true/false)
VITE_SERVICE_WORKER=true

# Lazy Loading (true/false)
VITE_LAZY_LOADING=true

# =============================================================================
# DEPLOYMENT EXAMPLES
# =============================================================================
# 
# FOR PRODUCTION DEPLOYMENT, UPDATE THESE VALUES:
# 
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# VITE_AI_AGENT_URL=https://ai.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/hub
# VITE_APP_ENV=production
# VITE_DEBUG=false
# VITE_CDN_URL=https://cdn.yourdomain.com
# VITE_MEDIA_URL=https://media.yourdomain.com
# 
# FOR STAGING DEPLOYMENT:
# 
# VITE_API_BASE_URL=https://staging-api.yourdomain.com/api
# VITE_AI_AGENT_URL=https://staging-ai.yourdomain.com/api
# VITE_WS_URL=wss://staging-api.yourdomain.com/hub
# VITE_APP_ENV=staging
# VITE_DEBUG=true
# 
# =============================================================================