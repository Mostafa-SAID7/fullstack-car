using Application.Features.Community.QA.Services;
using Domain.Entities.Community.QA;
using Domain.Entities.Identity;
using Domain.Enums.Community.QA;
using Domain.Interfaces;
using Domain.Services;
using Domain.ValueObjects.Community;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using System.Text.Json;

namespace Infrastructure.Services.QA;

public class ExpertService : IExpertService
{
    private readonly IRepository<QAExpert> _expertRepository;
    private readonly IRepository<UserReputation> _reputationRepository;
    private readonly IRepository<Answer> _answerRepository;
    private readonly IRepository<Question> _questionRepository;
    private readonly IRepository<QACategory> _categoryRepository;
    private readonly IRepository<ApplicationUser> _userRepository;
    private readonly Domain.Services.IReputationService _reputationService;
    private readonly ILogger<ExpertService> _logger;
    private readonly IUnitOfWork _unitOfWork;

    public ExpertService(
        IRepository<QAExpert> expertRepository,
        IRepository<UserReputation> reputationRepository,
        IRepository<Answer> answerRepository,
        IRepository<Question> questionRepository,
        IRepository<QACategory> categoryRepository,
        IRepository<ApplicationUser> userRepository,
        Domain.Services.IReputationService reputationService,
        ILogger<ExpertService> logger,
        IUnitOfWork unitOfWork)
    {
        _expertRepository = expertRepository;
        _reputationRepository = reputationRepository;
        _answerRepository = answerRepository;
        _questionRepository = questionRepository;
        _categoryRepository = categoryRepository;
        _userRepository = userRepository;
        _reputationService = reputationService;
        _logger = logger;
        _unitOfWork = unitOfWork;
    }

    #region Expert Detection and Ranking

    public async Task<List<Guid>> GetExpertsByCategoryAsync(string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null)
            {
                _logger.LogWarning("Category {Category} not found or inactive", category);
                return new List<Guid>();
            }

            var experts = await _expertRepository.GetAllAsync(
                e => e.CategoryId == categoryEntity.Id && 
                     e.NotificationEnabled &&
                     (e.ExpertiseLevel == "Expert" || e.ExpertiseLevel == "Master"),
                orderBy: q => q.OrderByDescending(e => e.ExpertiseLevel == "Master" ? 1 : 0)
                              .ThenByDescending(e => e.ResponseRate)
                              .ThenByDescending(e => e.AverageRating)
                              .ThenByDescending(e => e.AcceptedAnswerCount));

            return experts.Select(e => e.UserId).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting experts for category {Category}", category);
            return new List<Guid>();
        }
    }

    public async Task<List<ExpertRankingDto>> GetRankedExpertsAsync(string category, int count = 10)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null) return new List<ExpertRankingDto>();

            var experts = await _expertRepository.GetAllAsync(
                e => e.CategoryId == categoryEntity.Id,
                orderBy: q => q.OrderByDescending(e => e.ExpertiseLevel == "Master" ? 4 : 
                                                      e.ExpertiseLevel == "Expert" ? 3 :
                                                      e.ExpertiseLevel == "Intermediate" ? 2 : 1)
                              .ThenByDescending(e => e.AcceptedAnswerCount)
                              .ThenByDescending(e => e.AverageRating)
                              .ThenByDescending(e => e.ResponseRate),
                include: e => e.Include(x => x.User));

            var result = new List<ExpertRankingDto>();
            
            foreach (var expert in experts.Take(count))
            {
                var reputation = await _reputationRepository.GetBySpecificationAsync(
                    r => r.UserId == expert.UserId);

                var badges = new List<string>();
                if (reputation?.BadgesEarned != null)
                {
                    try
                    {
                        badges = JsonSerializer.Deserialize<List<string>>(reputation.BadgesEarned) ?? new List<string>();
                    }
                    catch (JsonException)
                    {
                        badges = new List<string>();
                    }
                }

                result.Add(new ExpertRankingDto
                {
                    UserId = expert.UserId,
                    UserName = expert.User?.UserName ?? "Unknown",
                    ExpertiseLevel = expert.ExpertiseLevel,
                    AnswerCount = expert.AnswerCount,
                    AcceptedAnswerCount = expert.AcceptedAnswerCount,
                    AverageRating = expert.AverageRating,
                    ResponseRate = expert.ResponseRate,
                    ReputationScore = reputation?.ReputationScore ?? 0,
                    Badges = badges
                });
            }

            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting ranked experts for category {Category}", category);
            return new List<ExpertRankingDto>();
        }
    }

    public async Task UpdateExpertStatsAsync(Guid userId, string category, string activityType)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null)
            {
                _logger.LogWarning("Category {Category} not found for user {UserId}", category, userId);
                return;
            }

            var expert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            if (expert == null)
            {
                expert = new QAExpert
                {
                    UserId = userId,
                    CategoryId = categoryEntity.Id,
                    ExpertiseLevel = "Beginner",
                    AnswerCount = 0,
                    AcceptedAnswerCount = 0,
                    AverageRating = 0,
                    ResponseRate = 0,
                    NotificationEnabled = true
                };
                await _expertRepository.AddAsync(expert);
            }

            await UpdateExpertStatistics(expert, activityType);

            var newLevel = await DetermineExpertiseLevelAsync(userId, category);
            if (expert.ExpertiseLevel != newLevel)
            {
                expert.ExpertiseLevel = newLevel;
                await CheckAndAwardExpertBadgesAsync(userId, category);
            }

            await _unitOfWork.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating expert stats for user {UserId} in category {Category}", userId, category);
        }
    }

    public async Task<bool> IsUserExpertInCategoryAsync(Guid userId, string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null) return false;

            var expert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            return expert != null && (expert.ExpertiseLevel == "Expert" || expert.ExpertiseLevel == "Master");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error checking expert status for user {UserId} in category {Category}", userId, category);
            return false;
        }
    }

    public async Task PromoteToExpertAsync(Guid userId, string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null)
            {
                _logger.LogWarning("Cannot promote user {UserId} - category {Category} not found", userId, category);
                return;
            }

            var expert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            if (expert == null)
            {
                expert = new QAExpert
                {
                    UserId = userId,
                    CategoryId = categoryEntity.Id,
                    ExpertiseLevel = "Expert",
                    NotificationEnabled = true
                };
                await _expertRepository.AddAsync(expert);
            }
            else
            {
                expert.ExpertiseLevel = "Expert";
            }

            await CheckAndAwardExpertBadgesAsync(userId, category);

            await _reputationService.RecordActivityAsync(
                userId, 
                ActivityType.ExpertiseAreaAdded, 
                expert.Id, 
                category, 
                50);

            await _unitOfWork.SaveChangesAsync();

            _logger.LogInformation("User {UserId} promoted to expert in category {Category}", userId, category);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error promoting user {UserId} to expert in category {Category}", userId, category);
        }
    }

    public async Task<string> DetermineExpertiseLevelAsync(Guid userId, string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null) return "Beginner";

            var answers = await _answerRepository.GetAllAsync(
                a => a.UserId == userId && 
                     a.Question.Category == category &&
                     !a.IsDeleted);

            if (!answers.Any()) return "Beginner";

            var totalAnswers = answers.Count();
            var acceptedAnswers = answers.Count(a => a.IsAccepted);
            var averageVoteScore = answers.Any() ? answers.Average(a => a.VoteScore) : 0;
            
            var reputation = await _reputationRepository.GetBySpecificationAsync(
                r => r.UserId == userId);
            
            var reputationScore = reputation?.ReputationScore ?? 0;
            var responseRate = await CalculateResponseRateAsync(userId, category);

            if (acceptedAnswers >= 50 && averageVoteScore >= 4.5 && responseRate >= 85 && reputationScore >= 5000)
            {
                return "Master";
            }
            else if (acceptedAnswers >= 10 && averageVoteScore >= 4.0 && responseRate >= 70 && reputationScore >= 1000)
            {
                return "Expert";
            }
            else if (acceptedAnswers >= 3 && averageVoteScore >= 2.0 && totalAnswers >= 10)
            {
                return "Intermediate";
            }
            else
            {
                return "Beginner";
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error determining expertise level for user {UserId} in category {Category}", userId, category);
            return "Beginner";
        }
    }

    #endregion

    #region Expert Notification System

    public async Task NotifyExpertsForQuestionAsync(Guid questionId, string category)
    {
        try
        {
            var experts = await GetNotifiableExpertsAsync(category);
            
            if (!experts.Any())
            {
                _logger.LogInformation("No notifiable experts found for category {Category}", category);
                return;
            }

            // In a real implementation, this would send notifications via email, push notifications, etc.
            // For now, we'll log the notification
            _logger.LogInformation("Notifying {ExpertCount} experts about question {QuestionId} in category {Category}", 
                experts.Count, questionId, category);

            // TODO: Implement actual notification sending (email, push, in-app)
            // This could integrate with existing notification infrastructure
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error notifying experts for question {QuestionId} in category {Category}", questionId, category);
        }
    }

    public async Task<List<Guid>> GetNotifiableExpertsAsync(string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null) return new List<Guid>();

            var experts = await _expertRepository.GetAllAsync(
                e => e.CategoryId == categoryEntity.Id && 
                     e.NotificationEnabled &&
                     (e.ExpertiseLevel == "Expert" || e.ExpertiseLevel == "Master" || e.ExpertiseLevel == "Intermediate"),
                orderBy: q => q.OrderByDescending(e => e.ExpertiseLevel == "Master" ? 3 : 
                                                      e.ExpertiseLevel == "Expert" ? 2 : 1)
                              .ThenByDescending(e => e.ResponseRate));

            return experts.Select(e => e.UserId).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting notifiable experts for category {Category}", category);
            return new List<Guid>();
        }
    }

    public async Task UpdateExpertNotificationPreferencesAsync(Guid userId, string category, bool enabled)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null)
            {
                _logger.LogWarning("Category {Category} not found for user {UserId}", category, userId);
                return;
            }

            var expert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            if (expert == null)
            {
                if (enabled)
                {
                    expert = new QAExpert
                    {
                        UserId = userId,
                        CategoryId = categoryEntity.Id,
                        ExpertiseLevel = "Beginner",
                        NotificationEnabled = true
                    };
                    await _expertRepository.AddAsync(expert);
                }
            }
            else
            {
                expert.NotificationEnabled = enabled;
            }

            await _unitOfWork.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating notification preferences for user {UserId} in category {Category}", userId, category);
        }
    }

    public async Task<Dictionary<string, bool>> GetExpertNotificationPreferencesAsync(Guid userId)
    {
        try
        {
            var experts = await _expertRepository.GetAllAsync(
                e => e.UserId == userId,
                include: e => e.Include(x => x.Category));

            return experts.ToDictionary(
                e => e.Category.Name,
                e => e.NotificationEnabled);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting notification preferences for user {UserId}", userId);
            return new Dictionary<string, bool>();
        }
    }

    #endregion

    #region Expert Badge and Recognition

    public async Task CheckAndAwardExpertBadgesAsync(Guid userId, string category)
    {
        try
        {
            var expert = await GetExpertInCategoryAsync(userId, category);
            if (expert == null) return;

            var badges = new List<Badge>();

            // Award badges based on expertise level
            switch (expert.ExpertiseLevel)
            {
                case "Expert":
                    if (!await _reputationService.HasBadgeAsync(userId, BadgeType.Expert, category))
                    {
                        badges.Add(Badge.CreateExpertBadge(category));
                    }
                    break;
                case "Master":
                    if (!await _reputationService.HasBadgeAsync(userId, BadgeType.Master, category))
                    {
                        badges.Add(Badge.CreateKnowledgeableBadge(category)); // Using knowledgeable as master equivalent
                    }
                    break;
            }

            // Award badges based on performance
            if (expert.AcceptedAnswerCount >= 10 && !await _reputationService.HasBadgeAsync(userId, BadgeType.TenAcceptedAnswers))
            {
                badges.Add(Badge.CreateHelpfulBadge());
            }

            if (expert.AcceptedAnswerCount >= 50 && !await _reputationService.HasBadgeAsync(userId, BadgeType.FiftyAcceptedAnswers))
            {
                badges.Add(Badge.CreateGreatAnswerBadge());
            }

            // Award badges
            foreach (var badge in badges)
            {
                await _reputationService.AwardBadgeAsync(userId, badge);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error checking and awarding expert badges for user {UserId} in category {Category}", userId, category);
        }
    }

    public async Task<List<string>> GetExpertBadgesAsync(Guid userId)
    {
        try
        {
            var badges = await _reputationService.GetUserBadgesAsync(userId);
            return badges.Where(b => b.Type == BadgeType.Expert || 
                                   b.Type == BadgeType.Knowledgeable || 
                                   b.Type == BadgeType.Master)
                         .Select(b => b.Name)
                         .ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expert badges for user {UserId}", userId);
            return new List<string>();
        }
    }

    public async Task<bool> HasExpertBadgeAsync(Guid userId, string category)
    {
        try
        {
            return await _reputationService.HasBadgeAsync(userId, BadgeType.Expert, category) ||
                   await _reputationService.HasBadgeAsync(userId, BadgeType.Master, category);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error checking expert badge for user {UserId} in category {Category}", userId, category);
            return false;
        }
    }

    #endregion

    #region Expert Preference Management

    public async Task<List<string>> GetUserExpertiseCategoriesAsync(Guid userId)
    {
        try
        {
            var experts = await _expertRepository.GetAllAsync(
                e => e.UserId == userId,
                include: e => e.Include(x => x.Category));

            return experts.Select(e => e.Category.Name).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expertise categories for user {UserId}", userId);
            return new List<string>();
        }
    }

    public async Task AddExpertiseCategoryAsync(Guid userId, string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null)
            {
                _logger.LogWarning("Category {Category} not found for user {UserId}", category, userId);
                return;
            }

            var existingExpert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            if (existingExpert == null)
            {
                var expert = new QAExpert
                {
                    UserId = userId,
                    CategoryId = categoryEntity.Id,
                    ExpertiseLevel = "Beginner",
                    NotificationEnabled = true
                };
                await _expertRepository.AddAsync(expert);
                await _unitOfWork.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error adding expertise category {Category} for user {UserId}", category, userId);
        }
    }

    public async Task RemoveExpertiseCategoryAsync(Guid userId, string category)
    {
        try
        {
            var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
                c => c.Name == category && c.IsActive);
            
            if (categoryEntity == null) return;

            var expert = await _expertRepository.GetBySpecificationAsync(
                e => e.UserId == userId && e.CategoryId == categoryEntity.Id);

            if (expert != null)
            {
                await _expertRepository.DeleteAsync(expert);
                await _unitOfWork.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error removing expertise category {Category} for user {UserId}", category, userId);
        }
    }

    public async Task UpdateExpertPreferencesAsync(Guid userId, ExpertPreferencesDto preferences)
    {
        try
        {
            // Update notification preferences for each category
            foreach (var categoryPref in preferences.CategoryNotifications)
            {
                await UpdateExpertNotificationPreferencesAsync(userId, categoryPref.Key, categoryPref.Value);
            }

            // TODO: Store other preferences (email, push, quiet hours, etc.) in user profile or separate table
            _logger.LogInformation("Updated expert preferences for user {UserId}", userId);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating expert preferences for user {UserId}", userId);
        }
    }

    public async Task<ExpertPreferencesDto> GetExpertPreferencesAsync(Guid userId)
    {
        try
        {
            var categoryNotifications = await GetExpertNotificationPreferencesAsync(userId);

            return new ExpertPreferencesDto
            {
                UserId = userId,
                CategoryNotifications = categoryNotifications,
                EmailNotifications = true, // TODO: Get from user profile
                PushNotifications = true, // TODO: Get from user profile
                MaxQuestionsPerDay = 10, // TODO: Get from user profile
                PreferredTags = new List<string>(), // TODO: Get from user profile
                TimeZone = "UTC", // TODO: Get from user profile
                QuietHoursEnabled = false, // TODO: Get from user profile
                QuietHoursStart = TimeSpan.FromHours(22),
                QuietHoursEnd = TimeSpan.FromHours(8)
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expert preferences for user {UserId}", userId);
            return new ExpertPreferencesDto { UserId = userId };
        }
    }

    #endregion

    #region Expert Analytics

    public async Task<ExpertAnalyticsDto> GetExpertAnalyticsAsync(Guid userId, string? category = null)
    {
        try
        {
            var reputation = await _reputationRepository.GetBySpecificationAsync(r => r.UserId == userId);
            var experts = await _expertRepository.GetAllAsync(
                e => e.UserId == userId && (category == null || e.Category.Name == category),
                include: e => e.Include(x => x.Category));

            var answersByCategory = new Dictionary<string, int>();
            var expertiseLevels = new Dictionary<string, string>();

            foreach (var expert in experts)
            {
                answersByCategory[expert.Category.Name] = expert.AnswerCount;
                expertiseLevels[expert.Category.Name] = expert.ExpertiseLevel;
            }

            var badges = new List<string>();
            if (reputation?.BadgesEarned != null)
            {
                try
                {
                    badges = JsonSerializer.Deserialize<List<string>>(reputation.BadgesEarned) ?? new List<string>();
                }
                catch (JsonException)
                {
                    badges = new List<string>();
                }
            }

            return new ExpertAnalyticsDto
            {
                UserId = userId,
                TotalAnswers = reputation?.AnswersGiven ?? 0,
                AcceptedAnswers = reputation?.AcceptedAnswers ?? 0,
                AcceptanceRate = reputation?.AnswersGiven > 0 ? 
                    (decimal)(reputation.AcceptedAnswers * 100) / reputation.AnswersGiven : 0,
                AverageRating = experts.Any() ? experts.Average(e => e.AverageRating) : 0,
                TotalUpvotes = reputation?.UpvotesReceived ?? 0,
                TotalDownvotes = reputation?.DownvotesReceived ?? 0,
                AnswersByCategory = answersByCategory,
                ExpertiseLevels = expertiseLevels,
                EarnedBadges = badges,
                LastActivity = reputation?.LastUpdated ?? DateTime.UtcNow,
                ReputationScore = reputation?.ReputationScore ?? 0
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expert analytics for user {UserId}", userId);
            return new ExpertAnalyticsDto { UserId = userId };
        }
    }

    public async Task<List<ExpertLeaderboardDto>> GetExpertLeaderboardAsync(string category, int count = 10)
    {
        try
        {
            var rankedExperts = await GetRankedExpertsAsync(category, count);
            
            return rankedExperts.Select((expert, index) => new ExpertLeaderboardDto
            {
                UserId = expert.UserId,
                UserName = expert.UserName,
                ExpertiseLevel = expert.ExpertiseLevel,
                AcceptedAnswers = expert.AcceptedAnswerCount,
                AverageRating = expert.AverageRating,
                ReputationScore = expert.ReputationScore,
                Rank = index + 1
            }).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expert leaderboard for category {Category}", category);
            return new List<ExpertLeaderboardDto>();
        }
    }

    public async Task<ExpertPerformanceDto> GetExpertPerformanceAsync(Guid userId, string category)
    {
        try
        {
            var expert = await GetExpertInCategoryAsync(userId, category);
            if (expert == null)
            {
                return new ExpertPerformanceDto
                {
                    UserId = userId,
                    Category = category,
                    ExpertiseLevel = "Beginner"
                };
            }

            var recentBadges = await GetExpertBadgesAsync(userId);

            return new ExpertPerformanceDto
            {
                UserId = userId,
                Category = category,
                ExpertiseLevel = expert.ExpertiseLevel,
                AnswerCount = expert.AnswerCount,
                AcceptedAnswerCount = expert.AcceptedAnswerCount,
                AcceptanceRate = expert.AnswerCount > 0 ? 
                    (decimal)(expert.AcceptedAnswerCount * 100) / expert.AnswerCount : 0,
                AverageRating = expert.AverageRating,
                ResponseRate = expert.ResponseRate,
                LastActivity = expert.UpdatedAt ?? expert.CreatedAt,
                RecentBadges = recentBadges
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting expert performance for user {UserId} in category {Category}", userId, category);
            return new ExpertPerformanceDto { UserId = userId, Category = category };
        }
    }

    #endregion

    #region Private Helper Methods

    private async Task UpdateExpertStatistics(QAExpert expert, string activityType)
    {
        var answers = await _answerRepository.GetAllAsync(
            a => a.UserId == expert.UserId && 
                 a.Question.Category == expert.Category.Name &&
                 !a.IsDeleted);

        expert.AnswerCount = answers.Count();
        expert.AcceptedAnswerCount = answers.Count(a => a.IsAccepted);
        expert.AverageRating = answers.Any() ? (decimal)answers.Average(a => a.VoteScore) : 0;
        expert.ResponseRate = await CalculateResponseRateAsync(expert.UserId, expert.Category.Name);
    }

    private async Task<decimal> CalculateResponseRateAsync(Guid userId, string category)
    {
        try
        {
            var userAnswers = await _answerRepository.GetAllAsync(
                a => a.UserId == userId && 
                     a.Question.Category == category &&
                     !a.IsDeleted);

            var totalQuestionsInCategory = await _questionRepository.CountAsync(
                q => q.Category == category && !q.IsDeleted);

            if (totalQuestionsInCategory == 0) return 0;

            var responseRate = (decimal)userAnswers.Count() / totalQuestionsInCategory * 100;
            return Math.Min(responseRate, 100);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error calculating response rate for user {UserId} in category {Category}", userId, category);
            return 0;
        }
    }

    private async Task<QAExpert?> GetExpertInCategoryAsync(Guid userId, string category)
    {
        var categoryEntity = await _categoryRepository.GetBySpecificationAsync(
            c => c.Name == category && c.IsActive);
        
        if (categoryEntity == null) return null;

        return await _expertRepository.GetBySpecificationAsync(
            e => e.UserId == userId && e.CategoryId == categoryEntity.Id,
            include: e => e.Include(x => x.Category));
    }

    #endregion
}